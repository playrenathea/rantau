  "policy": {
    "eligibility": "suitable_for Item has weight 0 and is not eligible for Place",
    "single_city": "weighted random across eligible Animal flavor words; tag overlap weight 3 else 1",
    "dual": "intersection of both Animal flavor pools, only tag-overlap candidates (weight 3), weighted random; none -> original place",
    "none": "original place",
    "gate": "original place name only",
    "tag_overlap": "nonempty intersection; no additive bonus for two or more matched tags",
    "max_tags": "editorially prefer 1–3; category semantics only; do not imply mechanics",
    "anti_tautology": "reject a Flavor if already a literal word in base Place label"
